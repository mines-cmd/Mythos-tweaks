    <Style x:Key="TopPanelMenu" TargetType="{x:Type ContextMenu}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Border BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Background="{TemplateBinding Background}"
                            Grid.IsSharedSizeScope="True" CornerRadius="16">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                      Padding="8">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

<Style x:Key="TopPanelFilterToggle" TargetType="CheckBox">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Margin" Value="5,3,0,0" />
    <Setter Property="Foreground" Value="{DynamicResource HoverBrush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
        <Setter.Value>
            <ControlTemplate TargetType="CheckBox">
                <Grid>
                    <Border x:Name="Border"
                            Background="{DynamicResource ControlIdleBackgroundBrush}"
                            BorderThickness="2"
                            BorderBrush="{DynamicResource ControlIdleBorderBrush}"
                            CornerRadius="{DynamicResource ControlCornerRadius}" />

                    <TextBlock Text="&#xe16e;" FontSize="14" Foreground="{TemplateBinding Foreground}"
                               Style="{DynamicResource IconFontStyle}" />
                </Grid>

                <ControlTemplate.Triggers>

                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Border" Property="Background" Value="{DynamicResource ControlHoverBackgroundBrush}" />
                    </Trigger>

                    <!--<Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="Border" Property="Background" Value="{DynamicResource ControlPressedBrush}" />
                        <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource ControlIdleBorderBrush}" />
                    </Trigger>-->

                    <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Border" Property="Background" Value="{DynamicResource ControlHoverBackgroundBrush}" />
                        <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AccentIdleBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource ActuallyWhiteBrushBrush}" />
                    </Trigger>

                    <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="Border" Property="Opacity" Value="0.4" />
                        <Setter Property="Cursor" Value="Arrow" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value>
    </Setter>
</Style>


    <Style x:Key="TopPanelNotificationsToggle" TargetType="ToggleButton">
    	<Setter Property="Margin" Value="0,5,5,0" />
        <Setter Property="Width" Value="35" />
        <Setter Property="Height" Value="35" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource ActuallyWhiteBrushBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Grid>
                        <Border Name="HoverBg" Background="{DynamicResource GreenBrush}" BorderThickness="0" BorderBrush="{DynamicResource ControlIdleBorderBrush}"
                                CornerRadius="{DynamicResource ControlCornerRadius}" Opacity="1"/>
                        <TextBlock Text="&#xE896;" FontSize="16"
                                       Foreground="{TemplateBinding Foreground}" 
                                       Style="{DynamicResource IconFontStyle}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverBg"
                                                         Storyboard.TargetProperty="Opacity" 
                                                         To="0.75" Duration="0:0:0.6">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverBg"
                                                         Storyboard.TargetProperty="Opacity" 
                                                         To="1" Duration="0:0:0.6">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Api Notifications.Count}" Value="0">
                <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource ActuallyWhiteBrushBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type TopPanel}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TopPanel}">
                    <Border Height="60" BorderBrush="{DynamicResource PanelSeparatorBrush}"
                            Background="{TemplateBinding Background}"
                            d:DesignWidth="1280"
                            d:DataContext="{x:Static DesignMainViewModel.DesignIntance}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Settings ShowPanelSeparators}" Value="False">
                                        <Setter Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Border x:Name="PART_ElemMainMenu" Margin="0,0,0,0" Cursor="Hand" VerticalAlignment="Center"
                                        WindowChrome.IsHitTestVisibleInChrome="True">
                                    <Image Source="{ThemeFile 'Images/drawer.png'}"
                                           Height="28" RenderOptions.BitmapScalingMode="Fant"
                                           Margin="20,2,0,0" SnapsToDevicePixels="True"/>
                                </Border>
                                <SearchBox x:Name="PART_TextMainSearch" Grid.Column="1" Style="{DynamicResource TopPanelSearchBox}"
                                           Margin="22,2,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           WindowChrome.IsHitTestVisibleInChrome="True" />
                                <CheckBox x:Name="PART_ToggleFilter" ToolTip="{DynamicResource LOCFilters}"
                                              Style="{DynamicResource TopPanelFilterToggle}" />
				<!--<Border Width="1" Background="{DynamicResource ControlIdleBorderBrush}" Height="24" Margin="10,3,5,0" />
                                <StackPanel x:Name="PART_PanelMainItems" Orientation="Horizontal"
                                            VerticalAlignment="Stretch" Margin="0,6,0,6"/>-->
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <StackPanel x:Name="PART_PanelMainItems" Orientation="Horizontal"
                                            VerticalAlignment="Stretch" Margin="0,6,0,6"/>

                                <StackPanel x:Name="PART_PanelMainPluginItems" Orientation="Horizontal"
                                            VerticalAlignment="Stretch" Margin="0,6,0,6"/>
                            </StackPanel>

                            <DockPanel Grid.Column="2" Margin="0,0,120,0">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <CheckBox x:Name="PART_ToggleNotifications" 
                                              Style="{DynamicResource TopPanelNotificationsToggle}" />
                                </StackPanel>
                                
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,5,0">
                                    <!--<Grid MinWidth="250" MaxWidth="250">
                                        <ProgressBar Name="PART_ProgressGlobal" Margin="5,3,0,0"/>
                                        <TextBlock Name="PART_TextProgressText" 
                                                   VerticalAlignment="Center" HorizontalAlignment="Center" 
                                                   Style="{DynamicResource BaseTextBlockStyle}" Margin="8,2,8,0" />
                                    </Grid>-->

                                    <Button Name="PART_ButtonProgressCancel" Height="35" VerticalAlignment="Center" 
                                            Content="&#xEDAB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" IsHitTestVisible="False"
                                            WindowChrome.IsHitTestVisibleInChrome="False"/>
                                </StackPanel>
                            </DockPanel>

                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>