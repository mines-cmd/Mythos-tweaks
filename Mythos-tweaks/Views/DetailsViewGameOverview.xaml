                             Foreground="{DynamicResource TextBrush}"
                             FontWeight="SemiBold" Style="{DynamicResource BaseTextBlockStyle}"
                             FontSize="{DynamicResource FontSizeLarge}"/>
                        <TextBox x:Name="PART_TextNotes" IsReadOnly="True"
                           BorderThickness="0" Foreground="{DynamicResource ButtonTextBrush}"
                           AcceptsReturn="True" TextWrapping="Wrap"
                           VerticalScrollBarVisibility="Disabled" MaxHeight="300"
                           Margin="0,5,0,18" Padding="0" Background="Transparent" FontFamily="{DynamicResource MonospaceFontFamily}"
               FontSize="16"/>
                      </StackPanel>

                      <Grid HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="0,20,0,10">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <DockPanel Grid.Column="0">
                          <Border Width="0" BorderThickness="0" Margin="0,0,0,0"
                              Background="{DynamicResource PanelSeparatorBrush}" />

                          <!--Extra Logo-->
                          <Grid Height="200" Margin="10,10,40,10">
                            <Border x:Name="GameIcon" CornerRadius="0">
                              <Image Name="PART_ImageIcon" VerticalAlignment="Center" HorizontalAlignment="Left"
                                  RenderOptions.BitmapScalingMode="Fant" MaxHeight="120" MaxWidth="120"/>
                              <Border.Style>
                                <Style TargetType="Border">
                                  <Setter Property="Visibility" Value="Collapsed" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=EnableLogos, FallbackValue=False}" Value="False">
                                      <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=IsLogoAvailable, FallbackValue=False}" Value="False">
                                      <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}, FallbackValue=False}" Value="false" >
                                      <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </Border.Style>
                            </Border>
                            <Border x:Name="ExtraMetadataLoader_LogoLoaderControlGrid" VerticalAlignment="Center" HorizontalAlignment="Center" 
                                Tag="{DynamicResource DetailsViewAllowUseOfLogos}">
                              <Border.Style>
                                <Style TargetType="Border">
                                  <Setter Property="Visibility" Value="Visible" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=EnableLogos, FallbackValue=False}" Value="False">
                                      <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=IsLogoAvailable, FallbackValue=False}" Value="False">
                                      <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}, FallbackValue=False}" Value="false" >
                                      <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </Border.Style>
                              <ContentControl x:Name="ExtraMetadataLoader_LogoLoaderControl"/>
                            </Border>
                          </Grid>
                          <!--Extra Logo Ends-->

                          <!-- <StackPanel x:Name="PART_ElemGenres">
                            <StackPanel.Style>
                              <Style TargetType="{x:Type StackPanel}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Settings DetailsVisibility.Genres}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding Game.Genres}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </StackPanel.Style>

                            <Label Content="Genres"
                                 Foreground="{DynamicResource TextBrushDarker}" FontSize="{StaticResource FontSize}" FontWeight="Medium"/>
                            <Grid Margin="0,5,0,0">
                              <ItemsControl ItemsSource="{Binding Game.Genres}" Margin="0,4,0,0">
                                <ItemsControl.ItemsPanel>
                                  <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                                  </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate>
                                    <Button Content="{Binding Name}" Style="{StaticResource PropertyItemTagButton}"
                                    Command="{Binding DataContext.SetGenreFilterCommand, RelativeSource={RelativeSource AncestorType={x:Type Grid}}}"
                                    CommandParameter="{Binding}"/>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </Grid>
                          </StackPanel> -->
                        </DockPanel>

                        <DockPanel Grid.Column="1">
                          <Border Width="1" BorderThickness="0" Margin="0,0,15,0"
                              Background="{DynamicResource PanelSeparatorBrush}" />

                          <!-- Container StackPanel -->
                          <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                            <!--Age Ratings-->
                            <ItemsControl ItemsSource="{Binding Game.AgeRatings}">
                                <ItemsControl.ItemsPanel>
                                  <ItemsPanelTemplate>
                                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                                  </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <Grid HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,0,0,10">
                                      <Border x:Name="Mask" Background="#000000" CornerRadius="{DynamicResource ControlCornerRadius}" />

                                      <Image x:Name="AgeRatingIcon"
                                            MaxHeight="1024"
                                            MaxWidth="300"
                                            Source="{ThemeFileBinding Name, PathFormat='Images/AgeRating/{0}.bmp'}"
                                            StretchDirection="Both"
                                            Stretch="Uniform"
                                            RenderOptions.BitmapScalingMode="HighQuality"
                                            SnapsToDevicePixels="True"
                                            UseLayoutRounding="True"
                                            Margin="0"/>

                                      <Border BorderBrush="{DynamicResource ControlIdleBorderBrush}"
                                            BorderThickness="2"
                                            CornerRadius="{DynamicResource ControlCornerRadius}"
                                            Background="Transparent"
                                            Width="300" 
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Stretch"
                                            Panel.ZIndex="1"/>
                          
                                        <Grid.OpacityMask>
                                          <VisualBrush Visual="{Binding ElementName=Mask}"/>
                                        </Grid.OpacityMask>
                                  </Grid>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!--Age ratings ends-->

                            <!--HowLongToBeat-->
                            <StackPanel Margin="0,0,0,0" Visibility="{PluginSettings Plugin=HowLongToBeat, Path=HasData, FallbackValue=Collapsed, Converter={StaticResource BooleanToVisibilityConverter}}">    
                              <Border CornerRadius="{DynamicResource ControlCornerRadius}" 
                                  Style="{DynamicResource DetailViewCardBorder}"
                                  Background="#000000" 
                                  Margin="0,0,0,0"
                                  BorderThickness="2"
                                  BorderBrush="{DynamicResource ControlIdleBorderBrush}">
                    
                                <StackPanel Margin="0,0,0,0">
                                  <StackPanel.Resources>
                                    <Style TargetType="Label" x:Key="HltbGridLabelStyle">
                                      <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
                                      <Setter Property="Foreground" Value="{DynamicResource IdleBrush}"/>
                                      <Setter Property="HorizontalAlignment" Value="Center" />
                                    </Style>
                                    <Style TargetType="Border" x:Key="HltbBorderStyle">
                                      <Setter Property="Background" Value="{DynamicResource IdleBrush}"/>
                                      <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
                                    </Style>
                                    <Style TargetType="TextBlock" x:Key="HltbGridTextStyle" BasedOn="{StaticResource BaseTextBlockStyle}">
                                      <Setter Property="Foreground" Value="{DynamicResource WhiteBrush}"/>
                                      <Setter Property="Margin" Value="8,8,8,8" />
                                      <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}"/>
                                      <Setter Property="FontWeight" Value="Bold"/>
                                      <Setter Property="Visibility" Value="Visible" />
                                      <Setter Property="HorizontalAlignment" Value="Center"/>
                                      <Style.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Text}" Value="--">
                                          <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                      </Style.Triggers>
                                    </Style>
                                  </StackPanel.Resources>

                                  <Grid Margin="16,12,16,16">
                                    <Grid.ColumnDefinitions>
                                      <ColumnDefinition Width="*"/>
                                      <ColumnDefinition Width="*"/>
                                      <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                      <Label Content="{DynamicResource LOCHowLongToBeatMainStory}"
                                            Style="{DynamicResource HltbGridLabelStyle}"
                                            Visibility="{Binding ElementName=MainStoryFormat, Path=Visibility}" />
                                      <Border Style="{DynamicResource HltbBorderStyle}">
                                        <TextBlock Name="MainStoryFormat" Style="{DynamicResource HltbGridTextStyle}"
                                                Text="{PluginSettings Plugin=HowLongToBeat, Path=MainStoryFormat, FallbackValue='--'}"/>
                                      </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                      <Label Content="Extra"
                                            Style="{DynamicResource HltbGridLabelStyle}"
                                            Visibility="Visible"/>
                                      <Border Style="{DynamicResource HltbBorderStyle}">
                                        <TextBlock Name="MainExtraFormat"
                                                Style="{DynamicResource HltbGridTextStyle}"
                                                Text="{PluginSettings Plugin=HowLongToBeat, Path=MainExtraFormat, FallbackValue='--'}"/>
                                      </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Margin="0,0,0,0">
                                      <Label Content="Completion"
                                            Style="{DynamicResource HltbGridLabelStyle}"
                                            Visibility="Visible"/>
                                      <Border Style="{DynamicResource HltbBorderStyle}">
                                        <TextBlock Name="CompletionistFormat"
                                                Style="{DynamicResource HltbGridTextStyle}"
                                                Text="{PluginSettings Plugin=HowLongToBeat, Path=CompletionistFormat, FallbackValue='--'}"/>
                                      </Border>
                                    </StackPanel>
                                  </Grid>

                                  <Border Background="{DynamicResource GlobalBackgroundBrush}" CornerRadius="0,0,16,16">
                                  </Border>

                                </StackPanel>
                              </Border>
                            </StackPanel>
                            <!--HowLongToBeat Ends-->   
                          </StackPanel>

                          <!-- <StackPanel x:Name="PART_ElemFeatures">
                            <StackPanel.Style>
                              <Style TargetType="{x:Type StackPanel}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Settings DetailsVisibility.Features}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding Game.Genres}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </StackPanel.Style>

                            <Label Content="Features"
                                 Foreground="{DynamicResource TextBrushDarker}" FontSize="{StaticResource FontSize}" FontWeight="Medium"/>
                            <Grid Margin="0,5,0,0">
                              <ItemsControl ItemsSource="{Binding Game.Features}" Margin="0,4,0,0">
                                <ItemsControl.ItemsPanel>
                                  <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                                  </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate>
                                    <Button Content="{Binding Name}" Style="{StaticResource PropertyItemTagButton}"
                                    Command="{Binding DataContext.SetFeatureFilterCommand, RelativeSource={RelativeSource AncestorType={x:Type Grid}}}"
                                    CommandParameter="{Binding}"/>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </Grid>
                          </StackPanel> -->
                        </DockPanel>
                      </Grid>
                    </StackPanel>

                    <!--Tab Table-->
                    <StackPanel DockPanel.Dock="Top" HorizontalAlignment="Stretch">

                      <TextBlock FontFamily="{DynamicResource FontFamily}" Name="PART_TextDisplayName" Margin="0,0,0,5"
                             FontSize="{DynamicResource FontSizeLarger}" FontWeight="Bold"
                             TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}">
                      </TextBlock>

                      <!--<Border x:Name="PART_ElemDevelopers" >
                         <Grid>
                           <ItemsControl Name="PART_ItemsDevelopers" HorizontalAlignment="Left" Margin="0,0,0,12" />
                          </Grid>
                       </Border>-->

                      <TabControl Margin="0,0,0,16" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                            Style="{StaticResource DetailViewTabControl}">
                        <!--Tab Overview-->
                        <TabItem Header="" x:Name="DescriptionTab" FontSize="16" Style="{StaticResource DetailViewTabItem}" >

                          <StackPanel Margin="0,0,0,0">

                            <StackPanel x:Name="DescriptionContent" Margin="0,0,0,0" >
                              <StackPanel Name="PART_ElemDescription">
                                <HtmlTextView Name="PART_HtmlDescription" Margin="0,0,0,0" HorizontalAlignment="Stretch"
                                        HtmlFontSize="{DynamicResource FontSize}"
                                        HtmlFontFamily="{DynamicResource MonospaceFontFamily}"
                                        HtmlForeground="{DynamicResource TextColorDarker}"
                                        LinkForeground="{DynamicResource AccentSelectedColor}" 
                                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                        ScrollViewer.VerticalScrollBarVisibility="Disabled"/>
                              </StackPanel>
                            </StackPanel>
                          </StackPanel>
                        </TabItem>
                      </TabControl>
                    </StackPanel>
                    <!--Tab Table Ends-->

                    <!--Right Part-->
                    <StackPanel Margin="0,0,0,40" Grid.Row="1" Grid.Column="1">

                      <!-- SuccessStory -->
                      <StackPanel Visibility="{PluginSettings Plugin=SuccessStory, Path=HasData, Mode=OneWay, FallbackValue={x:Static Visibility.Collapsed}}">

                        <Separator Background="{DynamicResource PanelSeparatorBrush}" Margin="0,0,0,24"/>

                        <DockPanel Margin="0,0,0,24">
                          <ContentControl x:Name="SuccessStory_PluginCompactList" DockPanel.Dock="Bottom" Margin="0,16,0,0" />
                          <ContentControl x:Name="SuccessStory_PluginProgressBar" DockPanel.Dock="Bottom" Margin="0,16,0,0" VerticalAlignment="Center" Height="24"/>
                          <!--<ContentControl x:Name="SuccessStory_PluginButton" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"/>-->
                          <TextBlock Text="{DynamicResource LOCSuccessStoryAchievements}" DockPanel.Dock="Left" VerticalAlignment="Center"
             Style="{DynamicResource BaseTextBlockStyle}" FontWeight="Bold" FontSize="20"/>
                        </DockPanel>
                      </StackPanel>

                    </StackPanel>
                    <!--Right Part Ends-->

                  </StackPanel>
                  <!--Left Side Ends-->

                </Grid>
              </ScrollViewer>
            </Grid>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>