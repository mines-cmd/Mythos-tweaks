    <CornerRadius x:Key="GridViewSelectionBorderCornerRadius">0</CornerRadius>

    <!--End-->

    <sys:Double x:Key="FontSizeSmaller">10</sys:Double>
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSize">14</sys:Double>
    <sys:Double x:Key="FontSizeLarge">16</sys:Double>
    <sys:Double x:Key="FontSizeLarge18">18</sys:Double>
    <sys:Double x:Key="FontSizeLarge20">20</sys:Double>
    <sys:Double x:Key="FontSizeLarge24">24</sys:Double>
    <sys:Double x:Key="FontSizeLarge28">28</sys:Double>
    <sys:Double x:Key="FontSizeLarge32">32</sys:Double>
    <sys:Double x:Key="FontSizeLarge40">40</sys:Double>
    <sys:Double x:Key="FontSizeLarge48">48</sys:Double>
    <FontFamily x:Key="FontFamily">Inter</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Inter Mod</FontFamily>

    <sys:Double x:Key="EllipseBorderThickness">2</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadiusLarge">16</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadiusLargeX">24</CornerRadius>
    
    <Thickness x:Key="PopupBorderThickness">2</Thickness>
    <Thickness x:Key="ControlBorderThickness">2</Thickness>
    <Thickness x:Key="SidebarItemPadding">8</Thickness>
    <Thickness x:Key="ButtonBorder">2</Thickness>

    <Color x:Key="BlackColor">#707275</Color>
    <Color x:Key="WhiteColor">#15181b</Color>
    <Color x:Key="GreenColor">#3cab78</Color>
    <Color x:Key="TextColor">#e7e9ea</Color>
    <Color x:Key="TextColorDarker">#71767B</Color>
    <Color x:Key="TextColorDark">#FF000000</Color>
    <Color x:Key="MainColor">#2C3A67</Color>
    <Color x:Key="MainColorDark">#0D1225</Color>
    <Color x:Key="HoverColor">#247BA0</Color>
    <Color x:Key="GlyphColor">#15181b</Color>
    <Color x:Key="HighlightGlyphColor">#FF0379FF</Color>
    <Color x:Key="AccentIdleColor">#FF0379FF</Color>
    <Color x:Key="AccentSelectedColor">#FF04A5FF</Color>

    <SolidColorBrush x:Key="GreenBrush" Color="{DynamicResource GreenColor}" />

    <Color x:Key="PopupBackgroundColor">#000000</Color>
    <Color x:Key="PopupBorderColor">#202931</Color>
    
    <Color x:Key="BackgroundToneColor">#FFCC00</Color>
    <Color x:Key="GridItemBackgroundColor">#151e3d</Color>

    <Color x:Key="PanelSeparatorColor">#15181b</Color>

    <Color x:Key="WindowPanelSeparatorColor">#1415181b</Color>
    <Color x:Key="DataChangeNotifColor">#ffa500</Color>

    <!--FusionX Newly Added Color-->
    <Color x:Key="8%White">#1415181b</Color>
    <Color x:Key="16%White">#2915181b</Color>
    <Color x:Key="24%White">#3D15181b</Color>
    <Color x:Key="36%White">#5C15181b</Color>
    <Color x:Key="40%White">#6615181b</Color>
    <Color x:Key="Brown">#795548</Color>
    <Color x:Key="BrownDark">#280B0A</Color>
    <!--FusionX Newly Added Color Ends-->

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#E6000000" />

    <SolidColorBrush x:Key="GlobalBackgroundBrush" Color="Transparent" />
    
    <!--InputStyle-->
    <!-- <SolidColorBrush x:Key="ControlIdleBackgroundBrush" Color="#504e5765" /> -->
    <LinearGradientBrush x:Key="ControlIdleBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,1" >
        <GradientStop Color="#506f7c90" Offset="0"/>
        <GradientStop Color="#504e5765" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ControlIdleBorderBrush" Color="#00000000" />

    <!-- <SolidColorBrush x:Key="ControlHoverBackgroundBrush" Color="#192129" /> -->
    <LinearGradientBrush x:Key="ControlHoverBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,1" >
        <GradientStop Color="#50c5cbd3" Offset="0"/>
        <GradientStop Color="#506f7c90" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ControlHoverBorderBrush" Color="#192129" />

    <!-- <SolidColorBrush x:Key="ControlSelectedBackgroundBrush" Color="#506f7c90" /> -->
    <LinearGradientBrush x:Key="ControlSelectedBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,1" >
        <GradientStop Color="#509aa3b1" Offset="0"/>
        <GradientStop Color="#506f7c90" Offset="1"/>
    </LinearGradientBrush>
    <!--InputStyle Ends-->

    <!--PopupStyle-->
    <SolidColorBrush x:Key="PopupIdleBackgroundBrush" Color="#15181b" />
    <SolidColorBrush x:Key="PopupHoverBackgroundBrush" Color="#21252b" />
