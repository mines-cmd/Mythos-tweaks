    <SolidColorBrush x:Key="ControlFilledHoverBackgroundBrush" Color="{DynamicResource 24%White}" />

    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />

    <SolidColorBrush x:Key="WhiteBrush" Color="#15181b" />
    <SolidColorBrush x:Key="ActuallyWhiteBrushBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="White60Brush" Color="#9915181b" />
    <SolidColorBrush x:Key="White40Brush" Color="#6615181b" />

    <!--ButtonStyle-->
    <SolidColorBrush x:Key="ButtonIdleBackgroundBrush" Color="#e7e9ea" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="#707275" />
    <SolidColorBrush x:Key="ButtonBrush" Color="#15181b" />

    <!-- <SolidColorBrush x:Key="SecondaryButtonIdleBackgroundBrush" Color="#15181b" /> -->
    <LinearGradientBrush x:Key="SecondaryButtonIdleBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,1" >
        <GradientStop Color="#FF202931" Offset="0"/>
        <GradientStop Color="#FF15181b" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SecondaryButtonHoverBackgroundBrush" Color="#1c1f22" />
    <SolidColorBrush x:Key="SecondaryButtonBrush" Color="#e7e9ea" />
    <!--ButtonStyle Ends-->

    <SolidColorBrush x:Key="DisabledBrush" Color="#21252b" />
    <SolidColorBrush x:Key="LinkButtonBrush" Color="#6800D1" />
